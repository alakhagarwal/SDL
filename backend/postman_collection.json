    {
      "name": "4. Security - FR-003 Invalid Credentials Handling",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 401 Unauthorized', function () { pm.response.to.have.status(401); });",
              "var jsonData = pm.response.json();",
              "pm.test('Generic error message without revealing user existence (FR-003)', function () {",
              "  pm.expect(jsonData.message).to.include('Invalid email or password credentials');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
